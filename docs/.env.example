# Example Environment Variables for WK Community OS Deployment Scripts

# The Google Apps Script ID of the target project.
SCRIPT_ID="YOUR_APPS_SCRIPT_PROJECT_ID_HERE"

# The ID of the Google Drive folder where backups will be stored.
BACKUP_FOLDER_ID="YOUR_GOOGLE_DRIVE_BACKUP_FOLDER_ID"

# The ID of the Google Drive folder for complaint attachments.
ATTACHMENT_FOLDER_ID="YOUR_GOOGLE_DRIVE_ATTACHMENT_FOLDER_ID"

# The ID of the Google Drive folder for generated letter PDFs.
PDF_EXPORT_FOLDER_ID="YOUR_GOOGLE_DRIVE_PDF_EXPORT_FOLDER_ID"

# A long, random secret key for cryptographic operations.
APP_SECRET_KEY="generate-a-long-random-secret-and-paste-it-here"